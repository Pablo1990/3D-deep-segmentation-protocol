// User parameters
// Override on the command line:  --input_dir /path/to/images
// Or supply a params file:       -params-file params.yml
params {

    // Paths to data directories (relative to the launch directory by default)
    input_dir        = "data/raw"
    output_dir       = "results"
    visual_dir       = "results/visualizations"
    visual_train_dir = "results/visualizations_training"
    train_dir        = "results/training/train"
    test_dir         = "results/training/test"
    training_set_dir = "results/training"

    // Cellpose initial segmentation parameters
    cellpose {
        pretrained_model  = 'cyto3'
        chan              = 0
        diameter          = 60
        cellprob_threshold = 0
        stitch_threshold  = 0.05
        dP_smooth         = 0.0
        anisotropy        = 1.0
        use_gpu           = true
    }

    // Cellpose training parameters
    train {
        pretrained_model  = 'cyto3'
        new_model         = 'CP_improved_100'
        chan              = 0
        diameter          = 60
        cellprob_threshold = 0
        stitch_threshold  = 0.05
        dP_smooth         = 0.0
        anisotropy        = 1.0
        use_gpu           = true
    }
}